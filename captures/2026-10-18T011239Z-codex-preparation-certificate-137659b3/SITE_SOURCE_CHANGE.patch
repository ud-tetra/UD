+   divergence=[sum(z[e]*((i==n)-(j==n)) for e,(i,j,b) in enumerate(edges)) for n in range(15)]
+   check('diamond_divergence_'+str(len(diamonds)),divergence==[0]*15 and sum(v*v for v in z)==4)
