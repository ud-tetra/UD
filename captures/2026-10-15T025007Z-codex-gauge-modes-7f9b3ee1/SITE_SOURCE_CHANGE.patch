+th=slice(0,28);ee=slice(28,56);xx=slice(56,71);uu=slice(71,86);yy=slice(86,101);vv=slice(101,116)
+Qred=s.zeros(116);Qred[th,th]=PT;Qred[ee,ee]=PT
