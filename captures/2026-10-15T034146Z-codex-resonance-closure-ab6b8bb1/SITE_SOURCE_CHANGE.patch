+    h=.5*np.dot(E,E)+kappa*np.sum(1-np.cos(eps*Cn@theta))+hm
+    return h,2*(np.vdot(f[4:],f[4:]).real+eps**2*np.vdot(d[4:],d[4:]).real),np.vdot(f,f).real,np.vdot(d,d).real,np.vdot(f,d),float(np.max(abs(Rn@E-q)))
+campaigns=[]
