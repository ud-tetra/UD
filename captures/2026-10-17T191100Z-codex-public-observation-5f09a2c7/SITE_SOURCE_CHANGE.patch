+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Unified Dynamics public research atlas: finite tetrahedral mathematics, declared dynamics, source provenance and independently testable physical questions."><meta name="theme-color" content="#f7f6ef"><title>Native admission · Unified Dynamics</title><link rel="icon" href="/assets/icon.svg" type="image/svg+xml"><link rel="stylesheet" href="/assets/style.css"><script src="/assets/app.js" defer></script><script src="/assets/native-admission-v0.1.js" defer></script></head><body data-page="native-admission"><a class="skip" href="#main">Skip to content</a><aside class="sidebar"><a class="brand" href="/"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 3L3 33H37Z M20 3L22 23L3 33 M22 23L37 33"/></svg><div>Unified<br>Dynamics<small>PUBLIC RESEARCH ATLAS</small></div></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Explore <span>☰</span></button><nav id="navigation" aria-label="Primary"><a href="/" ><span>01</span>Overview</a><a href="/primer/" ><span>02</span>Primer</a><a href="/mathematics/" ><span>03</span>Mathematics</a><a href="/dynamics/" ><span>04</span>Dynamics</a><a href="/evidence/" ><span>05</span>Evidence</a><a href="/papers/" ><span>06</span>Papers</a><a href="/sources/" ><span>07</span>Sources</a><a href="/history/" ><span>08</span>History</a><a href="/contribution/" ><span>09</span>Contribution</a><a href="/updates/" ><span>10</span>Updates</a><a href="/reconciliation/"><span>11</span>Reconciliation</a><a href="/dependencies/"><span>12</span>Dependencies</a><a href="/source-contract/"><span>13</span>Source contract</a><a href="/source-programme/"><span>14</span>Source programme</a><a href="/realization/"><span>15</span>Realization</a><a href="/joint-carrier/"><span>16</span>Joint carrier</a><a href="/programmed-clock/"><span>17</span>Programmed clock</a><a href="