+ # Decimal reporting endpoints are rounded out by one final decimal unit.
+ scale=10**digits;return [str((x*scale).lower().floor().fmpz())+'/'+str(scale),str((x*scale).upper().ceil().fmpz())+'/'+str(scale)]
