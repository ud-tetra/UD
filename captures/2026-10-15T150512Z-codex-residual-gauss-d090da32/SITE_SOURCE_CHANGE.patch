+ P0=sum(acts.values(),zero)/24;Pe=sum((sign(p)*acts[p] for p in pp),zero)/24;H3=[p for p in pp if p[0]==0];H8=[p for p in pp if {frozenset((p[0],p[2])),frozenset((p[1],p[3]))}=={frozenset((0,2)),frozenset((1,3))}]
