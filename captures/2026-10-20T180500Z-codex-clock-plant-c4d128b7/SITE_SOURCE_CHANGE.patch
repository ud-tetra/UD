diff --git a/dist/sources/clock-plant-v0.1/UD_CLOCK_PLANT_COMPATIBILITY_v0.1.tex b/dist/sources/clock-plant-v0.1/UD_CLOCK_PLANT_COMPATIBILITY_v0.1.tex
