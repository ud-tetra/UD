diff --git a/dist/sources/clock-plant-v0.1/clock_plant_certificate.py b/dist/sources/clock-plant-v0.1/clock_plant_certificate.py
new file mode 100644
index 0000000..7197495
--- /dev/null
+++ b/dist/sources/clock-plant-v0.1/clock_plant_certificate.py
@@ -0,0 +1,54 @@
+"""Exact clock/plant and alternative component-budget checks.
+Supplier limits are conditional specifications, not measurements. Budget
+obstructions apply to the inherited sufficient controller certificate.
+"""
+from fractions import Fraction as F
+import json
+def encode(x):
+    if isinstance(x,F):return {'exact':str(x),'decimal':float(x)}
+    if isinstance(x,dict):return {k:encode(v) for k,v in x.items()}
+    if isinstance(x,list):return [encode(v) for v in x]
+    return x
+def report():
+    K=F(101,4);M=F(81,10);nu=F(1,100000);q=F(1,25000)
+    b=K*(M*F(1,200000)+nu)+q+F(1,100000)+K*M/400000
+    total=F(3,400)+max(F(1,1000),b)
+    warm=F(145,16)/20000+K*(F(2,1000000)+nu)+q+F(1,100000)
+    dac_quant=F(10,2**20);dac_inl=F(20,2**20)
+    adc_inl=F(2)*F(2,1000000)
+    output_period=F(1024,1000000);moment=F(512,1000000);processing=F(100,1000000)
+    t0_min=400000*max(output_period,moment+processing)
+    assert b==F(29383,16000000)
+    assert total==F(149383,16000000)
+    assert F(1,100)-total==F(10617,16000000)
+    assert warm==F(6449,8000000) and warm<F(1,1000)
+    assert dac_quant+dac_inl==F(15,524288) and dac_quant+dac_inl<q
+    assert adc_inl<nu
+    assert t0_min==F(2048,5)
+    assert t0_min**2==F(4194304,25) and t0_min**2>1
+    assert M*F(1,625)==F(81,6250)>F(1,400)
+    weights=[F(2),F(-2),F(1)];ages=[F(0),F(1),F(2)]
+    assert sum(weights)==1 and sum(w*a for w,a in zip(weights,ages))==0
+    assert sum(abs(w)*a for w,a in zip(weights,ages))==4
+    return {
+      'status':'PASS_CONDITIONAL_MATHEMATICS_HARDWARE_HOLD','physical_promotion':0,
+      'alternative_budget':{'input_error':nu,'command_error':q,'tracking':b,
+       'total_residual':total,'slack':F(1,100)-total,'preload_tracking_upper':warm,
+       'endpoint_Gauss_parameters_unchanged':True},
+      'supplier_screen':{'AD5791B_quantization_plus_INL':dac_quant+dac_inl,
+       'AD5791B_other_error_allowance':q-dac_quant-dac_inl,
+       'AD5791B_conditions':'+/-10V references; B grade; 0 to 105 C; affine errors independently calibrated',
+       'LTC2500_32_INL_normalized':adc_inl,
+       'LTC2500_32_other_input_error_allowance':nu-adc_inl,
+       'note':'Neither remaining allowance has been empirically demonstrated'},
+      'clock_screen':{'output_period_seconds':output_period,
+       'assumed_absolute_filter_moment_seconds':moment,'assumed_other_latency_seconds':processing,
+       'required_t0_lower_seconds':t0_min,'required_each_LC_product_seconds_squared':t0_min**2,
+       'illustrative_t0_seconds':F(512),'LC_at_illustrative_t0_seconds_squared':F(512)**2,
+       'illustrative_prefix_seconds':F(512,100),'LC_le_one_seconds_squared_has_no_clock_overlap':True},
+      'certificate_floor_example':{'scope':'Inherited conservative L+lambda certificate; not a lower bound on actual physical error',
+       'A_seconds_lower':F(1,625),'r_seconds_upper':F(1),'clock_independent_cost_lower':M*F(1,625),
+       'tracking_allocation':F(1,400),'fails_this_sufficient_allocation':True},
+      'controls':{'status':'PASS','exact_controls':10,'constructor_only':True},
+      'hardware_status':'HOLD: canonical scales, calibrated residuals, finite-record identification, noise/latency coverage and independent review OPEN'}
+if __name__=='__main__':print(json.dumps(encode(report()),indent=2))
diff --git a/dist/sources/clock-plant-v0.1/finite_record_dependency.py b/dist/sources/clock-plant-v0.1/finite_record_dependency.py
new file mode 100644
index 0000000..e34be96
--- /dev/null
+++ b/dist/sources/clock-plant-v0.1/finite_record_dependency.py
@@ -0,0 +1,78 @@
+"""Exact arithmetic for a proposed short-window CD-1 certificate.
+
+Inputs are certified bounds that an apparatus return must supply. Defaults
+are a mathematical design example, not measured calibration or experiment.
+"""
+from fractions import Fraction as F
+import json
+
+def encode(x):
+    if isinstance(x,F):return {'exact':str(x),'decimal':float(x)}
+    if isinstance(x,dict):return {k:encode(v) for k,v in x.items()}
+    if isinstance(x,list):return [encode(v) for v in x]
+    return x
+
+def certificate(*,e0=F(1,10000),measurement=F(1,10000),delta=F(1,100),
+                h=F(1,100),clock=F(1,100000),age=F(1,100000),
+                plant_L=F(1),node=F(1,400),grid=F(1,400),other=F(1,400)):
+    L=F(97,4); LG=F(6); M=F(81,10); hmin=h-clock; hmax=h+clock
+    assert all(x>=0 for x in [e0,measurement,delta,clock,age,plant_L,node,grid,other])
+    assert hmin>0 and L*hmax<1
+    eta=(e0+delta*hmax)/(1-L*hmax)
+    # Sup error of the measured drift interval's certified endpoint:
+    # state transfer contributes LG*(eta+e0), measurement is counted twice
+    # because a robust PASS/FAIL uses |observed drift| +/- interval radius.
+    measurement_drift_radius=2*LG*measurement
+    B=LG*(eta+e0)+2*measurement_drift_radius
+    q_wrong=2*hmin-8*hmin*hmin-F(11,8)*hmin**3
+    q_frozen=2*hmin-F(8,3)*hmin**3
+    gate_lower=F(1,100)*(1+hmin)
+    gate_upper=F(1,100)*(1+hmax)
+    delay=(L+plant_L)*M*age
+    total=node+grid+delay+other
+    age_cap=F(1,400)/((L+plant_L)*M)
+    tube=F(3,4)+3*hmax+eta+measurement
+    margins={'nominal_pass':gate_lower-B,'wrong_species_fail':q_wrong-B-gate_upper,
+             'frozen_electric_fail':q_frozen-B-gate_upper,
+             'initial_Gauss_gate':F(1,100)-LG*e0-2*LG*measurement,
+             'tube':1-tube,'residual_budget':delta-total,
+             'delay_allocation':F(1,400)-delay}
+    okay=all(v>0 for v in margins.values())
+    return {'status':'PASS_CONDITIONAL_DESIGN' if okay else 'HOLD_NOT_CERTIFIED',
+      'input_kind':'illustrative certified-bound inputs; no apparatus data',
+      'physical_promotion':0,
+      'inputs':{'initial_error':e0,'snapshot_error':measurement,'vectorfield_defect':delta,
+       'nominal_window':h,'clock_radius':clock,'control_age':age,'plant_L':plant_L,
+       'aggregate_calibration_node_bound':node,'aggregate_grid_bound':grid,
+       'unmodeled_bound':other},
+      'constants':{'vectorfield_L':L,'Gauss_L':LG,'speed_M':M},
+      'hmin':hmin,'hmax':hmax,'trajectory_error':eta,
+      'decision_error_B':B,'wrong_sign_ideal_drift_lower':q_wrong,
+      'frozen_electric_ideal_drift_lower':q_frozen,
+      'CD1_gate_lower':gate_lower,'CD1_gate_upper':gate_upper,
+      'max_age_for_delay_allocation':age_cap,'delay_bound':delay,
+      'total_defect_bound':total,'margins':margins}
+
+def selftest():
+    base=certificate()
+    assert base['status']=='PASS_CONDITIONAL_DESIGN'
+    assert base['max_age_for_delay_allocation']==F(1,81810)
+    assert certificate(measurement=F(1,1000))['status']=='HOLD_NOT_CERTIFIED'
+    assert certificate(age=F(1,1000))['status']=='HOLD_NOT_CERTIFIED'
+    # Check the exact zero-clock simplification independently.
+    z=certificate(clock=F(0),delta=F(1,1000))
+    assert z['decision_error_B']==F(391,101000)
+    # Finite scalar samples cannot bound between-node residual without a
+    # derivative bound: P(x)=A*product(x-gridpoint) vanishes on each node.
+    nodes=[F(-1),F(0),F(1)]
+    def bump(x,A):return A*(x+1)*x*(x-1)
+    assert all(bump(x,F(1000))==0 for x in nodes)
+    assert abs(bump(F(1,2),F(1000)))==F(375)
+    return {'status':'PASS','exact_controls':7,
+            'scope':'Arithmetic and finite-sampling obstruction controls; not independent review'}
+
+if __name__=='__main__':
+    output={'certificate':certificate(),'controls':selftest(),
+      'negative_examples':{'too_coarse_metrology':certificate(measurement=F(1,1000)),
+                           'control_update_at_readout_interval':certificate(age=F(1,1000))}}
+    print(json.dumps(encode(output),indent=2))
