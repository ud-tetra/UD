+base=admission();v={k:F(x) for k,x in base['exact'].items()};eta=v['eta'];B=v['B'];delta2=v['legacy_delta_squared'];Dcap=v['norm_error_only_cap']
+check('unit_radius',eta==F(1,829538022))
