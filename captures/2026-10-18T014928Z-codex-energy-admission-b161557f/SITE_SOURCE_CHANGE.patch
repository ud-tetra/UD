diff --git a/dist/sources/energy-admission-v0.1/check_norm_gauss.py b/dist/sources/energy-admission-v0.1/check_norm_gauss.py
new file mode 100644
index 0000000..492e558
--- /dev/null
+++ b/dist/sources/energy-admission-v0.1/check_norm_gauss.py
@@ -0,0 +1,53 @@
+"""Floating constructor diagnostics, distinct from exact enclosure arithmetic."""
+from preparation_certificate import carrier
+from scipy.linalg import expm
+import numpy as np,json
+from pathlib import Path
+nodes,edges,*_=carrier();rng=np.random.default_rng(20261018)
+adj=np.zeros((15,15))
+for i,j,b in edges:adj[i,j]=adj[j,i]=1
+_,V=np.linalg.eigh(adj);v=V[:,-1];v*=np.sign(v.sum());v/=np.linalg.norm(v)
+def norm(a):return float(np.linalg.norm(a))
+def herm(r):
+ a=rng.normal(size=(r,r))+1j*rng.normal(size=(r,r));return (a+a.conj().T)/2
+
+def h(U,r):
+ D=np.zeros((15*r,15*r),complex)
+ for u,(i,j,b) in zip(U,edges):D[i*r:(i+1)*r,j*r:(j+1)*r]=b*u
+ return 1j*(D.conj().T-D)
+
+def gauss(U,E,q,w,nq,nw):
+ G=[-nq*np.outer(x,x.conj())+nw*np.outer(y,y.conj()) for x,y in zip(q,w)]
+ for u,e,(i,j,b) in zip(U,E,edges):G[i]+=e;G[j]-=u.conj().T@e@u
+ return np.array(G)
+rows=[]
+for r in [1,2,3,5]:
+ U=[np.diag([-1j*b]+[1]*(r-1)).astype(complex) for i,j,b in edges];q=np.zeros((15,r),complex);q[:,0]=v
+ A=[herm(r) for e in edges];p=rng.normal(size=q.shape)+1j*rng.normal(size=q.shape);p-=q*np.vdot(q,p).real
+ speed=np.sqrt(sum(norm(a)**2 for a in A)+norm(p)**2);A=[a/speed for a in A];p/=speed
+ H=h(U,r);H1=h([1j*a@u for a,u in zip(A,U)],r)
+ fprime=2*np.vdot(p.ravel(),H@q.ravel()).real+np.vdot(q.ravel(),H1@q.ravel()).real
+ assert abs(fprime)<1e-12
+ ratios=[]
+ for trial in range(8):
+  X=[expm(1j*herm(r))@u for u in U];z=rng.normal(size=q.shape)+1j*rng.normal(size=q.shape);z/=norm(z);p=rng.normal(size=q.shape)+1j*rng.normal(size=q.shape);p-=z*np.vdot(z,p).real;A=[herm(r) for e in edges]
+  speed=np.sqrt(sum(norm(a)**2 for a in A)+norm(p)**2);A=[a/speed for a in A];p/=speed;c2=norm(p)**2
+  H=h(X,r);H1=h([1j*a@u for a,u in zip(A,X)],r);H2=h([-a@a@u for a,u in zip(A,X)],r);z=z.ravel();p=p.ravel()
+  f2=2*np.vdot(p,H@p).real-2*c2*np.vdot(z,H@z).real+4*np.vdot(p,H1@z).real+np.vdot(z,H2@z).real
+  assert abs(f2)<=20+1e-12;ratios.append(abs(f2)/20)
+ # Near-nominal nonzero Gauss level; use a known comparison path length.
+ nq,nw=1.03,.98;scale=.01;A=[herm(r) for e in edges];E=[herm(r) for e in edges]
+ p=rng.normal(size=q.shape)+1j*rng.normal(size=q.shape);p-=q*np.vdot(q,p).real
+ z=rng.normal(size=q.shape)+1j*rng.normal(size=q.shape);z-=q*np.vdot(q,z).real
+ speed=np.sqrt(sum(norm(a)**2 for a in A+E)+norm(p)**2+norm(z)**2);A=[a*scale/speed for a in A];E=[e*scale/speed for e in E];p*=scale/speed;z*=scale/speed
+ def sphere(p):
+  t=norm(p);return np.cos(t)*q+np.sin(t)/t*p
+ Q,W=sphere(p),sphere(z);X=[expm(1j*a)@u for a,u in zip(A,U)];G=gauss(X,E,Q,W,nq,nw);G0=gauss(U,[np.zeros((r,r),complex) for e in edges],q,q,nq,nw)
+ L=np.sqrt(8+4*nq*nq+4*nw*nw);difference=norm(G-G0)
+ assert difference<=L*scale;assert abs(sum(np.trace(g).real for g in G)-(nw-nq))<1e-12
+ assert norm(G)>=abs(nw-nq)/np.sqrt(15*r)
+ gs=[expm(1j*herm(r)) for i in nodes];Xg=[gs[i]@x@gs[j].conj().T for x,(i,j,b) in zip(X,edges)];Eg=[gs[i]@e@gs[i].conj().T for e,(i,j,b) in zip(E,edges)];Qg=np.array([g@x for g,x in zip(gs,Q)]);Wg=np.array([g@x for g,x in zip(gs,W)])
+ Gg=gauss(Xg,Eg,Qg,Wg,nq,nw);cov=norm(Gg-np.array([g@x@g.conj().T for g,x in zip(gs,G)]));assert cov<1e-12
+ rows.append({'rank':r,'nominal_single_species_first_derivative_abs':abs(fprime),'random_hessian_fixtures':8,'max_hessian_over_bound':max(ratios),'comparison_path_length':scale,'gauss_difference':difference,'gauss_difference_bound':L*scale,'global_trace':sum(np.trace(g).real for g in G),'trace_target':nw-nq,'gauss_covariance_residual':cov})
+result={'status':'PASS_NUMERICAL_DIAGNOSTICS','rows':rows,'scope':'32 random geodesic Hessian fixtures, four centering and four Gauss/covariance controls. Nonzero Gauss states are ambient controls, not zero-source constrained-action solutions. No trajectory or empirical data.','physical_promotion':0}
+(Path(__file__).parent/'NORM_GAUSS_DIAGNOSTIC_v0.1.json').write_text(json.dumps(result,indent=2)+'\n');print('PASS: 32 Hessian fixtures, 4 centering and 4 Gauss/covariance controls')
diff --git a/dist/sources/energy-admission-v0.1/energy_admission.py b/dist/sources/energy-admission-v0.1/energy_admission.py
new file mode 100644
index 0000000..69acf9b
--- /dev/null
+++ b/dist/sources/energy-admission-v0.1/energy_admission.py
@@ -0,0 +1,36 @@
+"""Rational sufficient energy admission in the ambient Hamiltonian model.
+Input upper bounds and norm enclosures require external certified joint coverage.
+Nonzero Gauss levels are not zero-source constrained-action solutions.
+"""
+from fractions import Fraction as F
+from parity_budget import constants,sqrt_bracket
+import argparse,json
+
+def interval(x):
+ lo,hi=map(F,x)
+ if not 0<lo<=hi:raise ValueError('positive ordered norm interval required')
+ return lo,hi
+
+def admission(a=F(1),N=F(1),eta=None,nq=('1','1'),nw=('1','1'),score_upper=F(0),energy_upper=F(0),nu=F(0),beta_other=F(0),variation=F(0)):
+ a,N=F(a),F(N)
+ if a<=0 or N<=0:raise ValueError('positive a,N required')
+ _,_,_,_,_,R,_,J,_=constants(a,N);eta=R if eta is None else F(eta)
+ if not 0<eta<=R:raise ValueError('eta outside frozen certified radius')
+ qL,qU=interval(nq);wL,wU=interval(nw)
+ P,F0,nu,beta_other,T=map(F,[score_upper,energy_upper,nu,beta_other,variation])
+ if min(P,nu,beta_other,T)<0:raise ValueError('nonnegative bounds required except relative energy')
+ D=max(abs(qL-N),abs(qU-N))+max(abs(wL-N),abs(wU-N))
+ beta_norm=20*D;beta=beta_other+beta_norm;c=N/1600;B=c*eta**4;cap=c*eta**3/8
+ centered=nu+eta*beta<=cap;geom=P<=eta**2/4;energy=F0<=B/2
+ static=centered and geom and energy;timed=static and T<=cap
+ # Trace = n_w-n_q, so every possible norm pair is imbalanced only if intervals disjoint.
+ traceL=wL-qU;traceU=wU-qL;trace_abs_lower=max(F(0),traceL,-traceU)
+ # g <= D+sqrt(8+4*nq^2+4*nw^2)*d. Squared safe upper avoids radicals.
+ G2=2*D**2+2*(8+4*qU*qU+4*wU*wU)*P
+ vals={'a':a,'N':N,'eta':eta,'J':J,'B':B,'legacy_delta_squared':c*eta**4/J,'geometric_score_ceiling':eta**2/4,'initial_relative_energy_ceiling':B/2,'norm_error_sum_bound':D,'norm_centered_hessian_bound':beta_norm,'total_centered_hessian_bound':beta,'generic_gradient_bound':nu,'gradient_budget_cap':cap,'gradient_budget_spent':nu+eta*beta,'cumulative_gradient_variation':T,'static_nominal_energy_upper':F0+nu*eta+beta*eta**2/2,'time_nominal_energy_upper':F0+nu*eta+beta*eta**2/2+eta*T,'gauss_squared_upper_from_score':G2,'global_trace_lower':traceL,'global_trace_upper':traceU,'global_trace_abs_lower':trace_abs_lower,'norm_error_only_cap':N*eta**2/256000,'geometric_ceiling_over_legacy_score_ceiling':(eta**2/4)/(c*eta**4/J)}
+ return {'status':'CERTIFIED_SUFFICIENT_ENERGY_ADMISSION' if static else 'NOT_CERTIFIED_BY_THIS_BOUND','time_status':'CERTIFIED_THROUGH_DECLARED_VARIATION_HORIZON' if timed else 'NOT_CERTIFIED_BY_THIS_BOUND','gates':{'mixed_error':centered,'geometric':geom,'energy':energy,'variation':T<=cap},'exact':{k:str(v) for k,v in vals.items()},'decimal_diagnostics':{k:float(v) for k,v in vals.items()},'zero_gauss_norm_compatibility':'IMPOSSIBLE_FOR_ALL_NORMS_IN_INTERVALS' if trace_abs_lower>0 else 'NOT_ESTABLISHED_BY_NORM_INTERVALS','gauss_upper_bracket':sqrt_bracket(G2),'scope':'Ambient temporal-gauge Hamiltonian trapping; requires guaranteed enclosures and all frozen model premises. No constraint repair, data realizability or physical admissibility inferred. Norms are constant in this theorem.','physical_promotion':0}
+
+if __name__=='__main__':
+ p=argparse.ArgumentParser(description=__doc__);p.add_argument('input');x=p.parse_args()
+ with open(x.input) as f:record=json.load(f)
+ print(json.dumps(admission(**record),indent=2))
diff --git a/dist/sources/energy-admission-v0.1/parity_budget.py b/dist/sources/energy-admission-v0.1/parity_budget.py
new file mode 100644
index 0000000..f63cd92
--- /dev/null
+++ b/dist/sources/energy-admission-v0.1/parity_budget.py
@@ -0,0 +1,38 @@
+"""Exact sufficient trapping budget at the frozen quartic endpoint.
+All inputs are rational mathematical coefficients, not measured physical units.
+"""
+from fractions import Fraction as F
+from math import isqrt
+import argparse,json
+
+def constants(a=F(1),N=F(1)):
+ a,N=F(a),F(N);assert a>0 and N>0
+ alpha=min(a/2,N/100);D=279*N/(4*alpha);C3=279*N;C4=1600*N;C5=10000*N
+ S=F(9,2)*C3*C3*D*D/alpha+C3*D**3/6+C4*C4/(18*alpha)+5*C4*D*D+F(2,15)*C5*D+F(8,9)*C5*C5/alpha+264*N
+ linear=alpha/(500000*N);root2=N/(400*S)
+ # Exact rational lower radius for the potentially irrational root.
+ q=1/root2;m=isqrt(q.numerator//q.denominator)
+ if m*m*q.denominator<q.numerator:m+=1
+ R=min(linear,F(1,m));E=N*(2177*D*D+F(800,3)*D+F(19,6))+F(1280000,9)*N*N/alpha
+ old=min(alpha/(10000*N),N/(400*E));J=max(a,25*N)
+ return a,N,alpha,D,S,R,old,J,min(linear*linear,root2)
+
+def sqrt_bracket(q,digits=70):
+ scale=10**digits;n=isqrt(q.numerator*scale*scale//q.denominator)
+ lo,hi=F(n,scale),F(n+1,scale);assert lo*lo<=q<=hi*hi
+ return [str(lo),str(hi)]
+
+def budget(a=F(1),N=F(1),eta=None):
+ a,N,alpha,D,S,R,old,J,ideal2=constants(a,N);eta=R if eta is None else F(eta)
+ assert 0<eta<=R
+ checks={'positive_radius':R>0,'radius_le_one':R<=1,'shift_small':D*R<F(1,2),
+ 'fast_absorption':F(3,8)*alpha+F(4,3)*279*N*R+17*1600*N*R**2+2*10000*N*R**3+4096*N*R**4<alpha/2,
+ 'quartic_absorption':S*R*R<=N/400,'distance_conversion':N*R*R/400<=alpha/2,
+ 'rational_radius_exceeds_50000_old':R>=50000*old,'inside_initial_ball':eta*eta*N/(1600*J)<1}
+ assert all(checks.values())
+ values={'a':a,'N':N,'alpha':alpha,'D':D,'S6':S,'R_cert':R,'R_ideal_squared':ideal2,'R_old':old,'radius_gain':R/old,'J':J,'eta':eta,'boundary_barrier':N*eta**4/1600,'initial_radius_squared':eta**4*N/(1600*J)}
+ return {'exact':{k:str(v) for k,v in values.items()},'decimal_diagnostics':{k:float(v) for k,v in values.items()},'initial_radius_rational_bracket':sqrt_bracket(values['initial_radius_squared']),'checks':checks}
+
+if __name__=='__main__':
+ p=argparse.ArgumentParser(description=__doc__);p.add_argument('--a',default='1');p.add_argument('--N',default='1');p.add_argument('--eta')
